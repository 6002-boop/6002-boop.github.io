        "    values='revenue_m'\n",
        ").reset_index()\n",
        "\n",
        "# Rename columns\n",
        "df_pivot.columns.name = None\n",
        "region_map = {\n",
        "    'United States': 'us_m',\n",
        "    'Taiwan':        'taiwan_m',\n",
        "    'China':         'china_m',\n",
        "    'Other':         'other_m',\n",
        "    'Other Americas':'other_m',  # FY2026 uses this name\n",
        "}\n",
        "df_pivot = df_pivot.rename(columns=region_map)\n",
        "\n",
        "# Ensure column exists (FY2026 uses Other Americas vs Other in prior years)\n",
        "if 'other_m' not in df_pivot.columns:\n",
        "    df_pivot['other_m'] = 0\n",
        "\n",
        "# Calculate percentages\n",
        "for col in ['us_m', 'taiwan_m', 'china_m', 'other_m']:\n",
        "    if col in df_pivot.columns:\n",
        "        pct_col = col.replace('_m', '_pct')\n",
        "        df_pivot[pct_col] = (df_pivot[col] / df_pivot['total_rev_m'] * 100).round(1)\n",
        "\n",
        "df_pivot = df_pivot.sort_values('fiscal_year').reset_index(drop=True)\n",
