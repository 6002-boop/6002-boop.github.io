        "# ── Step 6: Chart 1 - Revenue share stacked bar ─────────────\n",
        "\n",
        "YEARS   = df_pivot['fiscal_year'].tolist()\n",
        "X       = np.arange(len(YEARS))\n",
        "CUTOFF  = YEARS.index('FY2022') + 0.5\n",
        "PALETTE = {\n",
        "    'United States': '#378ADD',\n",
        "    'Taiwan':         '#5DCAA5',\n",
        "    'China (incl. HK)':'#E24B4A',\n",
        "    'Other':          '#B4B2A9',\n",
        "}\n",
        "\n",
        "fig1, ax = plt.subplots(figsize=(14, 5.5))\n",
        "fig1.patch.set_facecolor(BG)\n",
        "ax.set_facecolor(BG)\n",
        "\n",
        "bottoms = np.zeros(len(YEARS))\n",
        "for label, col in [('United States','us_pct'), ('Taiwan','taiwan_pct'),\n",
        "                   ('China (incl. HK)','china_pct'), ('Other','other_pct')]:\n",
        "    if col not in df_pivot.columns:\n",
        "        continue\n",
        "    vals = df_pivot[col].fillna(0).values\n",
        "    bars = ax.bar(X, vals, 0.6, bottom=bottoms,\n",
        "                  color=PALETTE[label], label=label, zorder=2)\n",
        "    for bar, v, b in zip(bars, vals, bottoms):\n",
        "        if v >= 9:\n",
        "            ax.text(bar.get_x() + bar.get_width()/2, b + v/2,\n",
        "                    f'{v:.0f}%', ha='center', va='center',\n",
        "                    fontsize=8, color='white', fontweight='bold')\n",
        "    bottoms += vals\n",
        "\n",
